.env
.env.*
!.env.example
*.pem
*.key
*.cert
proxies.txt
temp_mail_vault.json
target_mail_claimed.json
received_otp.txt
collected_maxxspace_mails.jsonl

# ─────────────────────────────────────────────────────────────────
