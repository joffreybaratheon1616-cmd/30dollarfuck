# ─────────────────────────────────────────────────────────────────
accstore_data/
sessions/
downloads/
uploads/
*.session
*.session-journal
*.zip
*.tar.gz
*.7z
*.rar

# ─────────────────────────────────────────────────────────────────
# 3. Python Cache & Virtual Environments
# ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ─────────────────────────────────────────────────────────────────
