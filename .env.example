# ╔══════════════════════════════════════════════════════════════╗
# ║         AccStore — Configuration Template (.env.example)     ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Instructions:
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# ─────────────────────────────────────────────────────────────────
# 1. Telegram API Credentials (REQUIRED)
# ─────────────────────────────────────────────────────────────────
# Get your APP_ID and APP_HASH from: https://my.telegram.org
# Get your BOT_TOKEN from BotFather: https://t.me/BotFather
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ─────────────────────────────────────────────────────────────────
# 2. Bot Branding & Identity
# ─────────────────────────────────────────────────────────────────
PLATFORM_NAME=AccStore Session Manager
CHANNEL_LINK=https://t.me/your_channel
SUPPORT_LINK=https://t.me/your_support_group

# ─────────────────────────────────────────────────────────────────
# 3. Access Control & Security
# ─────────────────────────────────────────────────────────────────
# Comma-separated Telegram User IDs allowed to access the bot (leave blank for public)
ADMIN_IDS=12345678,98765432

# ─────────────────────────────────────────────────────────────────
# 4. Performance & Ports
# ─────────────────────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=20
SESSION_TIMEOUT=30
OPERATION_CHUNK_SIZE=10
SKIP_SPAMBOT=False
PORT=8090

# ─────────────────────────────────────────────────────────────────
# 5. Multi-User Proxy Pool & Auto-Failover Configuration
# ─────────────────────────────────────────────────────────────────
PROXY_TYPE=http
PROXY_ROTATION_ENABLED=True
PROXY_FILE=proxies.txt

# Primary Default Proxy
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_USER=username
PROXY_PASS=password

# Fallback Credentials
FALLBACK_PROXY_USER=username
FALLBACK_PROXY_PASS=password

# Multi-User Active Pool (Comma-separated host:port:user:pass)
PROXY_LIST=

# Dedicated FloodWait Failover Proxy
FLOODWAIT_PROXY_HOST=
FLOODWAIT_PROXY_PORT=
FLOODWAIT_PROXY_USER=
FLOODWAIT_PROXY_PASS=

# ─────────────────────────────────────────────────────────────────
# 6. Device Identity (Optional)
# ─────────────────────────────────────────────────────────────────
DEFAULT_DEVICE_MODEL=Samsung Galaxy S23 Ultra
DEFAULT_SYSTEM_VERSION=Android 13
DEFAULT_APP_VERSION=Telegram Android 10.14.5
DEFAULT_LANG_CODE=en
DEFAULT_SYSTEM_LANG_CODE=en

# ─────────────────────────────────────────────────────────────────
# 7. VPS SSH Deployment Settings (Optional)
# ─────────────────────────────────────────────────────────────────
VPS_HOST=127.0.0.1
VPS_PORT=22
VPS_USER=root
VPS_PASS=your_vps_password
REMOTE_DIR=/root/session_manager
